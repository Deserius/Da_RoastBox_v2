*.log

# Mobile signing keys and service credentials are never source/build assets.
*.jks
*.keystore
*.mobileprovision
**/key.properties
**/*-service-account.json

# Private filled deployment files and database exports are never source.
**/*.env
**/*.bson
**/*.archive
**/*.dump
**/*.wt
**/*.turtle
**/*.bak
**/*.backup
**/*.ndjson
**/*.jsonl

backend/media_tmp/

# Filled environment variants are private; checked-in examples remain allowed.
**/*.env.*
!**/.env.example
!**/*.env.example
# The frontend dev server's .env holds only proxy/binding settings and is
# committed so a fresh clone runs immediately. It must never contain a secret;
# provider credentials belong in the backend environment or the settings console.
!frontend/.env


# Prepared Windows binaries are a downloadable artifact, not cloud source.
runtime/

# Provider credentials entered through the Settings console.
# These are real secrets: keep them on this machine only.
backend/.env
backend/.env.local

# Locally assembled download package (see HOW_TO_RUN.md). Not cloud source.
/download/
