# New installs: generate JWT_SECRET once. Existing installs: preserve the current
# JWT/encryption secret exactly; changing it makes stored BYOK credentials unreadable.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=da_roastbox
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Original hosted integrations; leave blank until configured.
EMERGENT_LLM_KEY=
# Optional hosted OpenAI for vision and speech; selecting it can incur charges.
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=openai
# Default: photos + joke writing in ONE multimodal OpenRouter call.
# These models are paid. Set provider-account/key budgets before using them.
ROAST_WRITER_PROVIDER=openrouter
OPENROUTER_API_KEY=
ROAST_WRITER_PROFILE=multimodal
ROAST_OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,openai/gpt-4o
# Backups are attempted only after the OpenRouter model chain fails.
ROAST_BACKUP_PROVIDERS=emergent,openai
# Price ceilings in USD per million tokens, NOT total spending limits.
ROAST_MAX_INPUT_USD_PER_M=3.00
ROAST_MAX_OUTPUT_USD_PER_M=15.00
# Legacy opt-in profiles only (free or creative): separate photo observations.
ROAST_PAID_PRIMARY_MODEL=thedrummer/cydonia-24b-v4.1
ROAST_PAID_BACKUP_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
ROAST_WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ROAST_FREE_BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Legacy free/creative profiles only: optional endpoint pins, e.g. venice/fp8.
# Leave empty to let OpenRouter choose. With a pin, fallbacks are disabled by default so the
# upstream error surfaces instead of a silent reroute. Endpoint support and prices vary.
# Speed profile: fast, balanced or quality. Controls timeouts, output token budget,
# voice concurrency and whether the script is streamed into voice generation.
# Any individual value can be overridden, e.g. ROAST_WRITER_TIMEOUT_S=25.
# Preview/demo guardrails. -1 = unlimited (usage is still counted, nothing is blocked),
# 0 = hosted preview AI disabled, any positive number = per-day cap across preview accounts.
PREVIEW_HOSTED_DAILY_SHOW_LIMIT=-1
PREVIEW_HOSTED_DAILY_VOICE_LIMIT=-1
# Preview accounts cannot buy credits: charging nothing removes the credit requirement.
# Leave this off anywhere real users are billed.
PREVIEW_UNLIMITED_CREDITS=true
ROAST_SPEED_PROFILE=balanced
# Total wall-clock budget across multimodal writer attempts; not a cost budget.
ROAST_WRITER_DEADLINE_S=75
# Premium shows use ROAST_PAID_PRIMARY_MODEL; standard shows use this cheaper creative model.
ROAST_PAID_STANDARD_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Premium shows in the free profile use this :free model; standard uses ROAST_WRITER_MODEL.
ROAST_FREE_PREMIUM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ROAST_OPENROUTER_PROVIDER_ONLY=
ROAST_OPENROUTER_ALLOW_FALLBACKS=false
ROAST_FREE_WRITER_ONLY=false
ROAST_POLLINATIONS_FALLBACK=false
ROAST_ALLOW_PAID_WRITER_FALLBACK=true
ELEVENLABS_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Safe default for new/staging installs. Set false only for an intentional live launch.
STRIPE_TEST_ONLY=true
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
TTS_MODEL=gpt-4o-mini-tts

# "emergent" preserves the original object-store integration. "local" stores
# generated media under backend/local_storage by default (back it up separately).
STORAGE_BACKEND=emergent
# Optional. For Render's persistent disk, set /var/data/roastbox instead.
LOCAL_STORAGE_DIR=
# Exact public frontend origin for checkout. Render defaults to RENDER_EXTERNAL_URL;
# set APP_BASE_URL explicitly if using a custom domain.
APP_BASE_URL=

# Optional email/password sign-in. Off until an encrypted mail provider and
# APP_BASE_URL are configured. Keep SMTP credentials in your secret manager.
EMAIL_AUTH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (typically port 587) or ssl (typically port 465); never plaintext.
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Never enable these on a production database.
# The three preview switches work together: a preview account gets a disposable
# identity, all add-ons unlocked, and unlimited credits. Set the daily hosted
# limits above to -1 so nothing caps generation. All three are rejected outright
# when APP_ENV=production.
ENABLE_PREVIEW_LOGIN=false
# Optional shared, count-limited hosted AI for isolated previews only; usage is billable.
ALLOW_PREVIEW_HOSTED_AI=false
ALLOW_DEV_LOGIN=false
ALLOW_SOURCE_DOWNLOAD=false

# Owner settings console (Settings -> "Connect your services"). Lets an operator
# type provider keys into the running app instead of editing this file. It stays
# locked until the passphrase is entered, only preview/test accounts may open it,
# and it is refused in a production configuration. The environment always wins:
# a variable set here cannot be overwritten from the console.
ALLOW_RUNTIME_SETTINGS=false
RUNTIME_SETTINGS_PASSPHRASE=
# Optional allowlist of user ids or emails; empty = any preview/test account.
RUNTIME_SETTINGS_ADMINS=

# Local voice leveling (no external service). Raw voice files are retained.
VOICE_LEVELING_ENABLED=true
VOICE_TARGET_RMS_DBFS=-19

# Release hardening. Development preserves local/Arena iframe behavior.
# Use beta only after provisioning the extra password and persistent backend.
APP_ENV=development
ALLOWED_HOSTS=
# Paid deep diagnostics remain OFF. An enabled check also needs an explicit admin ID.
ENABLE_PAID_DIAGNOSTICS=false
DIAGNOSTICS_ADMIN_USER_IDS=
# Release-mode local media requires a real persistent volume and operator confirmation.
PERSISTENT_STORAGE_CONFIRMED=false
# Optional ephemeral read cache; never use this instead of durable media.
AUDIO_CACHE_DIR=
# Server-only isolated beta gate. Use the documented scrypt verifier format.
# Do not paste a plaintext password here or generate/rotate existing credentials automatically.
BETA_ACCESS_PASSWORD_HASH=
BETA_ACCESS_SIGNING_KEY=
