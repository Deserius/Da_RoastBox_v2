# Bind the dev server to all interfaces (needed for containers/previews).
# Remove to keep the dev server on localhost only.
HOST=0.0.0.0
PORT=3000
# Empty = same-origin /api (recommended behind a reverse proxy).
REACT_APP_BACKEND_URL=
# Development server forwards /api here; this address is never sent to browsers.
API_PROXY_TARGET=http://127.0.0.1:8001
# Preview login and source downloads must also be explicitly enabled on the backend.
REACT_APP_ENABLE_PREVIEW_LOGIN=false
REACT_APP_SOURCE_DOWNLOAD_ENABLED=false
# Optional public email for the menu's Contact the developer link.
REACT_APP_SUPPORT_EMAIL=
