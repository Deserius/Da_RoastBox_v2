# Local development configuration for the frontend dev server.
# This file is committed so a fresh clone can run immediately. It contains no
# credentials: only proxy/binding settings. Never put a provider secret here —
# anything in this file is compiled into the browser bundle.
#
# Provider keys belong in the backend environment, or in Settings -> "Connect
# your services" (the owner console), which stores them encrypted server-side.

# Bind the dev server to all interfaces (needed for containers and previews).
HOST=0.0.0.0
PORT=3000

# Empty = same-origin /api requests, which is what the proxy below provides.
REACT_APP_BACKEND_URL=
# Where the dev server forwards /api. Never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8001

# Show the "Browse as guest" preview button on the sign-in screen.
# The backend must also set ENABLE_PREVIEW_LOGIN=true.
REACT_APP_ENABLE_PREVIEW_LOGIN=true

# Source download is a release-hostile feature; leave off.
REACT_APP_SOURCE_DOWNLOAD_ENABLED=false

# Optional public email for the menu's "Contact the developer" link.
REACT_APP_SUPPORT_EMAIL=
