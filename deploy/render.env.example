# TEMPLATE ONLY. Never commit the filled-in private copy.
# Render Blueprint already supplies the nonsecret defaults below.
# Copy existing values privately. Never replace the existing JWT_SECRET.
APP_ENV=beta
APP_BASE_URL=https://YOUR-ASSIGNED-SERVICE.onrender.com
ALLOWED_HOSTS=YOUR-ASSIGNED-SERVICE.onrender.com
MONGO_URL=
DB_NAME=
JWT_SECRET=
# Set true ONLY after current authoritative data/media are copied and reconciled.
DATA_IMPORT_CONFIRMED=false
STORAGE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=
BETA_ACCESS_PASSWORD_HASH=
BETA_ACCESS_SIGNING_KEY=

# Required genuine hosted writing + speech. Free hosting is NOT free AI usage.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=openai
ROAST_WRITER_PROVIDER=openrouter
ROAST_WRITER_PROFILE=multimodal
ROAST_OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,openai/gpt-4o
ROAST_BACKUP_PROVIDERS=emergent,openai
ROAST_FREE_WRITER_ONLY=false
ROAST_ALLOW_PAID_WRITER_FALLBACK=true
# Optional configured gateway backup; preserve existing value if you use it.
EMERGENT_LLM_KEY=
# Optional hosted ElevenLabs; also supports an entitled user's own key.
ELEVENLABS_API_KEY=

STRIPE_TEST_ONLY=true
STRIPE_API_KEY=
# Signing secret for THIS Render URL's Stripe TEST webhook, not a live endpoint.
STRIPE_WEBHOOK_SECRET=
ENABLE_PAID_DIAGNOSTICS=false
ENABLE_PREVIEW_LOGIN=true
ALLOW_PREVIEW_HOSTED_AI=true
PREVIEW_UNLIMITED_CREDITS=true
PREVIEW_HOSTED_DAILY_SHOW_LIMIT=-1
PREVIEW_HOSTED_DAILY_VOICE_LIMIT=-1
ALLOW_DEV_LOGIN=false
ALLOW_SOURCE_DOWNLOAD=false
REEL_ENCODER_PRESET=ultrafast

# Optional HTTPS mail. Google/Explore do not require email registration.
# Render Free blocks SMTP 25/465/587; do not configure SMTP for this deployment.
EMAIL_AUTH_ENABLED=false
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=

# PUBLIC build-time settings. Never put credentials in REACT_APP_* variables.
# Empty URL means same-origin /api; do NOT enter localhost or the old deployment.
REACT_APP_BACKEND_URL=
REACT_APP_ENABLE_PREVIEW_LOGIN=true
REACT_APP_SOURCE_DOWNLOAD_ENABLED=false
REACT_APP_ENABLE_SESSION_TUNNEL=false
# Optional real support/social destinations; unset links are hidden, not fake.
REACT_APP_SUPPORT_EMAIL=
REACT_APP_INSTAGRAM_URL=
REACT_APP_FACEBOOK_URL=
REACT_APP_TIKTOK_URL=
REACT_APP_YOUTUBE_URL=
